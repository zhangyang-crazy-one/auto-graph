{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"format": {
			"type": "string",
			"const": "dge-scene"
		},
		"version": {
			"type": "number",
			"const": 1
		},
		"units": {
			"type": "string",
			"const": "m"
		},
		"frame": {
			"type": "object",
			"properties": {
				"x": {
					"type": "string",
					"const": "east"
				},
				"y": {
					"type": "string",
					"const": "north"
				},
				"z": {
					"type": "string",
					"const": "up"
				},
				"origin": {
					"type": "string",
					"const": "south-west floor corner"
				}
			},
			"required": ["x", "y", "z", "origin"],
			"additionalProperties": false
		},
		"name": {
			"type": "string"
		},
		"bounds": {
			"type": "object",
			"properties": {
				"width": {
					"type": "number"
				},
				"depth": {
					"type": "number"
				},
				"height": {
					"type": "number"
				}
			},
			"required": ["width", "depth"],
			"additionalProperties": false
		},
		"valid": {
			"type": "boolean",
			"description": "No interpenetration, nothing past the walls or ceiling, nothing off its support, every relation held."
		},
		"objects": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"position": {
						"type": "array",
						"prefixItems": [
							{
								"type": "number"
							},
							{
								"type": "number"
							},
							{
								"type": "number"
							}
						],
						"description": "Footprint center on the floor plan and bottom height [x, y, z], meters."
					},
					"yaw": {
						"type": "number",
						"description": "Turn about z, degrees counter-clockwise seen from above."
					},
					"quaternion": {
						"type": "array",
						"prefixItems": [
							{
								"type": "number"
							},
							{
								"type": "number"
							},
							{
								"type": "number"
							},
							{
								"type": "number"
							}
						],
						"description": "Its rotation as a unit quaternion [x, y, z, w]: the turn about z, then any lean with the slope."
					},
					"up": {
						"description": "The object's up axis in the world, when it leans with the slope (`align to slope`).",
						"type": "array",
						"prefixItems": [
							{
								"type": "number"
							},
							{
								"type": "number"
							},
							{
								"type": "number"
							}
						]
					},
					"size": {
						"type": "array",
						"prefixItems": [
							{
								"type": "number"
							},
							{
								"type": "number"
							},
							{
								"type": "number"
							}
						],
						"description": "Width, depth and height before the turn."
					},
					"front": {
						"type": "string",
						"enum": ["+x", "-x", "+y", "-y"],
						"description": "The object's own front before the turn."
					},
					"supportedBy": {
						"type": "string"
					},
					"aabb": {
						"type": "object",
						"properties": {
							"min": {
								"type": "array",
								"prefixItems": [
									{
										"type": "number"
									},
									{
										"type": "number"
									},
									{
										"type": "number"
									}
								]
							},
							"max": {
								"type": "array",
								"prefixItems": [
									{
										"type": "number"
									},
									{
										"type": "number"
									},
									{
										"type": "number"
									}
								]
							}
						},
						"required": ["min", "max"],
						"additionalProperties": false
					},
					"label": {
						"type": "string"
					},
					"asset": {
						"type": "string"
					},
					"group": {
						"type": "string"
					},
					"geo": {
						"description": "Where `position` is on the Earth (scenes with a frame).",
						"type": "object",
						"properties": {
							"lat": {
								"type": "number",
								"description": "WGS84 latitude, degrees."
							},
							"lon": {
								"type": "number",
								"description": "WGS84 longitude, degrees."
							},
							"alt": {
								"type": "number",
								"description": "Height above the WGS84 ellipsoid, metres."
							}
						},
						"required": ["lat", "lon", "alt"],
						"additionalProperties": false
					}
				},
				"required": [
					"id",
					"position",
					"yaw",
					"quaternion",
					"size",
					"front",
					"aabb"
				],
				"additionalProperties": false
			}
		},
		"openings": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"wall": {
						"type": "string",
						"enum": ["north", "south", "east", "west"]
					},
					"at": {
						"type": "number",
						"description": "Center along the wall from its west (or south) end."
					},
					"width": {
						"type": "number"
					}
				},
				"required": ["id", "wall", "at", "width"],
				"additionalProperties": false
			}
		},
		"agents": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"radius": {
						"type": "number"
					},
					"height": {
						"type": "number"
					},
					"speed": {
						"type": "number",
						"description": "Top speed, m/s."
					},
					"accel": {
						"type": "number",
						"description": "Acceleration and braking, m/s²."
					}
				},
				"required": ["id", "radius", "height", "speed", "accel"],
				"additionalProperties": false
			}
		},
		"paths": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"agent": {
						"type": "string"
					},
					"from": {
						"type": "string"
					},
					"to": {
						"type": "string"
					},
					"points": {
						"type": "array",
						"items": {
							"type": "array",
							"prefixItems": [
								{
									"type": "number"
								},
								{
									"type": "number"
								},
								{
									"type": "number"
								}
							]
						},
						"description": "Corners from start to end, [x, y, z] on the floor (or the ground)."
					},
					"length": {
						"type": "number"
					},
					"width": {
						"type": "number",
						"description": "The agent's width."
					},
					"clearance": {
						"type": "number",
						"description": "Least distance from the agent's edge to anything."
					},
					"start": {
						"type": "number",
						"description": "When the agent sets off, seconds."
					},
					"times": {
						"type": "array",
						"items": {
							"type": "number"
						},
						"description": "When the agent reaches each point, seconds (it starts and stops at rest, slows at corners)."
					},
					"duration": {
						"type": "number",
						"description": "Seconds from setting off to arriving."
					}
				},
				"required": [
					"id",
					"agent",
					"from",
					"to",
					"points",
					"length",
					"width",
					"clearance",
					"start",
					"times",
					"duration"
				],
				"additionalProperties": false
			}
		},
		"geo": {
			"description": "Where the scene sits on the Earth: scene metres are a local east-north-up frame at `origin`, turned by `heading`.",
			"type": "object",
			"properties": {
				"origin": {
					"type": "object",
					"properties": {
						"lat": {
							"type": "number",
							"description": "WGS84 latitude, degrees."
						},
						"lon": {
							"type": "number",
							"description": "WGS84 longitude, degrees."
						},
						"alt": {
							"type": "number",
							"description": "Height above the WGS84 ellipsoid, metres."
						}
					},
					"required": ["lat", "lon", "alt"],
					"additionalProperties": false
				},
				"datum": {
					"type": "string",
					"enum": ["WGS84", "GCJ02", "BD09"],
					"description": "The datum the document was written in; every output coordinate is WGS84."
				},
				"anchor": {
					"type": "array",
					"prefixItems": [
						{
							"type": "number"
						},
						{
							"type": "number"
						}
					],
					"description": "The scene point at the origin, metres."
				},
				"heading": {
					"type": "number",
					"description": "True bearing of the scene's +y axis, degrees clockwise from north."
				},
				"projection": {
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"kind": {
									"type": "string",
									"const": "enu"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"type": "string",
									"const": "utm"
								},
								"zone": {
									"type": "number"
								},
								"hemisphere": {
									"type": "string",
									"enum": ["N", "S"]
								},
								"epsg": {
									"type": "number"
								}
							},
							"required": ["kind", "zone", "hemisphere", "epsg"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"type": "string",
									"const": "web-mercator"
								},
								"epsg": {
									"type": "number",
									"const": 3857
								}
							},
							"required": ["kind", "epsg"],
							"additionalProperties": false
						}
					],
					"description": "How scene metres map to the Earth: a local east-north-up frame, or a map projection's grid (scene metres are its metres from the origin)."
				}
			},
			"required": ["origin", "datum", "anchor", "heading", "projection"],
			"additionalProperties": false
		},
		"landmarks": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"position": {
						"type": "array",
						"prefixItems": [
							{
								"type": "number"
							},
							{
								"type": "number"
							}
						],
						"description": "In the scene frame, metres."
					},
					"geo": {
						"type": "object",
						"properties": {
							"lat": {
								"type": "number",
								"description": "WGS84 latitude, degrees."
							},
							"lon": {
								"type": "number",
								"description": "WGS84 longitude, degrees."
							},
							"alt": {
								"type": "number",
								"description": "Height above the WGS84 ellipsoid, metres."
							}
						},
						"required": ["lat", "lon", "alt"],
						"additionalProperties": false
					}
				},
				"required": ["id", "position", "geo"],
				"additionalProperties": false
			}
		},
		"terrain": {
			"description": "The ground (scenes with terrain).",
			"type": "object",
			"properties": {
				"origin": {
					"type": "array",
					"prefixItems": [
						{
							"type": "number"
						},
						{
							"type": "number"
						}
					],
					"description": "Scene x, y of the south-west sample, metres."
				},
				"spacing": {
					"type": "array",
					"prefixItems": [
						{
							"type": "number"
						},
						{
							"type": "number"
						}
					],
					"description": "Distance between samples along x and y, metres."
				},
				"base": {
					"type": "number",
					"description": "Elevation at scene z = 0, metres."
				},
				"heights": {
					"type": "array",
					"items": {
						"type": "array",
						"items": {
							"type": "number"
						}
					},
					"description": "Elevations, rows south to north, each west to east; the ground between samples is bilinear, and scene z = elevation - base."
				}
			},
			"required": ["origin", "spacing", "base", "heights"],
			"additionalProperties": false
		},
		"unplaced": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "Objects left out of `objects`: no finite position (see the diagnostics)."
		},
		"diagnostics": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"severity": {
						"type": "string",
						"enum": ["info", "warning", "error"]
					},
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					},
					"objects": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"path": {
						"type": "array",
						"items": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "number"
								}
							]
						}
					},
					"hint": {
						"type": "string"
					},
					"detail": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"anyOf": [
								{
									"type": "number"
								},
								{
									"type": "string"
								}
							]
						}
					}
				},
				"required": ["severity", "code", "message"],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"format",
		"version",
		"units",
		"frame",
		"name",
		"bounds",
		"valid",
		"objects",
		"openings",
		"agents",
		"paths",
		"unplaced",
		"diagnostics"
	],
	"additionalProperties": false
}
